{
  "className": "pick",
  "purpose": "The reason and the people attached to an event pick.",
  "base": {
    "text-decoration": "none",
    "display": "block"
  },
  "elements": {
    "top": {
      "display": "flex",
      "justify-content": "space-between",
      "align-items": "flex-start",
      "gap": "{space.3}"
    },
    "link": {
      "display": "block",
      "color": "inherit",
      "text-decoration": "none"
    },
    "why": {
      "margin": "{space.1} 0 0",
      "font-size": "{type.size.md}",
      "font-weight": "{type.weight.medium}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.primary}"
    },
    "social": {
      "display": "flex",
      "align-items": "center",
      "margin": "{space.2} 0 0",
      "font-size": "{type.size.sm}",
      "color": "{color.text.secondary}"
    }
  },
  "variants": {
    "tone": {
      "highlight": {
        "box-shadow": "inset 0 0 0 {border.width.default} {color.accent.default}"
      }
    }
  },
  "interaction": {
    "__link": "dim"
  }
}
