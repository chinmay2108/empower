{
  "className": "person-hero",
  "uses": [
    "avatar",
    "ember"
  ],
  "purpose": "A match's portrait across the top of their profile, their own photo blurred behind it, fading into the page like Disney's title screen.",
  "base": {
    "position": "relative",
    "margin": "0 calc({space.5} * -1) {space.5}",
    "padding": "{space.7} {space.5} {space.5}",
    "overflow": "hidden",
    "isolation": "isolate",
    "&::after": {
      "content": "\"\"",
      "position": "absolute",
      "inset": "0",
      "z-index": "{layer.base}",
      "background": "linear-gradient(to top, {color.surface.canvas}, {color.scrim.none} 50%)",
      "pointer-events": "none"
    }
  },
  "elements": {
    "scene": {
      "position": "absolute",
      "inset": "calc({space.7} * -1)",
      "z-index": "{layer.base}",
      "opacity": "{opacity.dim}",
      "pointer-events": "none",
      "& .avatar": {
        "width": "100%",
        "height": "100%",
        "border-radius": "0",
        "object-fit": "cover",
        "filter": "blur({blur.overlay})"
      }
    },
    "photo": {
      "position": "relative",
      "z-index": "{layer.raised}",
      "& .avatar": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "aspect-ratio": "{ratio.square}",
        "border-radius": "0",
        "object-fit": "cover"
      },
      "width": "50%"
    },
    "body": {
      "position": "relative",
      "z-index": "{layer.raised}",
      "margin-top": "{space.4}"
    },
    "name": {
      "margin": "0",
      "text-wrap": "balance"
    },
    "line": {
      "display": "flex",
      "align-items": "center",
      "gap": "{space.2}",
      "margin": "{space.2} 0 0"
    },
    "meta": {
      "margin": "{space.1} 0 0",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "__photo": "poster"
  },
  "text": {
    "__photo & .avatar": "glyph-display",
    "__name": "display",
    "__meta": "meta"
  },
  "example": "<div class=\"person-hero\"><div class=\"person-hero__scene\" aria-hidden=\"true\"><img class=\"avatar avatar--photo\" src=\"../img/people/u017.jpg\" alt=\"\"></div><div class=\"person-hero__photo\"><img class=\"avatar avatar--lg avatar--photo\" src=\"../img/people/u017.jpg\" alt=\"\"></div><div class=\"person-hero__body\"><h1 class=\"person-hero__name\">Carlos M.</h1><p class=\"person-hero__line\"><span class=\"ember ember--blaze ember--lg\" aria-label=\"Empower score 76\"><svg class=\"ember__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5c1.2 3.6 5.5 5.6 5.5 10.7a5.5 5.5 0 0 1-11 0c0-2.8 1.6-4.5 2.7-5.6.3 2.2 1.6 3.3 2.7 3.3 0-3.3-1-5.8.1-8.4z\"/></svg><span class=\"ember__value\">76</span></span><span class=\"score-badge\">Open</span></p><p class=\"person-hero__meta\">Met at Thursday Trivia at Alamo Drafthouse</p></div></div>",
  "frame": "block"
}
