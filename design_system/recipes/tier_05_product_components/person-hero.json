{
  "className": "person-hero",
  "uses": [
    "avatar",
    "ember"
  ],
  "purpose": "A match's portrait across the top of their profile, their own photo blurred behind it, fading into the page like Disney's title screen.",
  "base": {
    "position": "relative",
    "margin": "0 calc({space.5} * -1) {space.5}",
    "padding": "{space.7} {space.5} {space.5}",
    "overflow": "hidden",
    "isolation": "isolate",
    "&::after": {
      "content": "\"\"",
      "position": "absolute",
      "inset": "0",
      "z-index": "{layer.base}",
      "background": "linear-gradient(to top, {color.surface.canvas}, {color.scrim.none} 50%)",
      "pointer-events": "none"
    }
  },
  "elements": {
    "scene": {
      "position": "absolute",
      "inset": "calc({space.7} * -1)",
      "z-index": "{layer.base}",
      "opacity": "{opacity.dim}",
      "pointer-events": "none",
      "& .avatar": {
        "width": "100%",
        "height": "100%",
        "border-radius": "0",
        "object-fit": "cover",
        "filter": "blur({blur.overlay})"
      }
    },
    "photo": {
      "position": "relative",
      "z-index": "{layer.raised}",
      "& .avatar": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "aspect-ratio": "{ratio.square}",
        "border-radius": "0",
        "object-fit": "cover",
        "font-size": "{type.size.display}"
      },
      "width": "50%"
    },
    "body": {
      "position": "relative",
      "z-index": "{layer.raised}",
      "margin-top": "{space.4}"
    },
    "name": {
      "margin": "0",
      "font-size": "{type.size.display}",
      "font-weight": "{type.weight.heavy}",
      "line-height": "{type.line_height.tight}",
      "letter-spacing": "{type.letter_spacing.tight}",
      "text-wrap": "balance"
    },
    "line": {
      "display": "flex",
      "align-items": "center",
      "gap": "{space.2}",
      "margin": "{space.2} 0 0"
    },
    "meta": {
      "margin": "{space.1} 0 0",
      "font-size": "{type.size.sm}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "__photo": "poster"
  }
}
