{
  "className": "swipe-card",
  "uses": [
    "event-art",
    "tag"
  ],
  "purpose": "The weekly pick: artwork fills the card, a fade carries the title, like Disney's featured card.",
  "base": {
    "background": "{color.surface.sunken}",
    "position": "relative",
    "grid-area": "1 / 1",
    "min-width": "0",
    "display": "flex",
    "flex-direction": "column",
    "justify-content": "flex-end",
    "align-items": "flex-start",
    "gap": "{space.2}",
    "min-height": "{size.deck}",
    "padding": "{size.card.art_clear} {space.5} {space.4}",
    "isolation": "isolate",
    "user-select": "none",
    "transform": "translateX({runtime.swipe_x}) rotate({runtime.swipe_angle})",
    "transition": "transform {motion.duration.medium} {motion.easing.standard}, opacity {motion.duration.medium} {motion.easing.standard}",
    "& .event-art": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "width": "100%",
      "aspect-ratio": "{ratio.square}",
      "border-radius": "0",
      "z-index": "{layer.base}",
      "pointer-events": "none"
    },
    "&::after": {
      "content": "\"\"",
      "position": "absolute",
      "top": "0",
      "left": "0",
      "width": "100%",
      "aspect-ratio": "{ratio.square}",
      "background": "linear-gradient(to top, {color.surface.sunken}, {color.scrim.soft} 50%, {color.scrim.none})",
      "pointer-events": "none"
    },
    "& > *:not(.event-art)": {
      "position": "relative",
      "z-index": "{layer.raised}"
    },
    "& > p": {
      "margin": "0"
    },
    "@media (prefers-reduced-motion: reduce)": {
      "transition": "none"
    },
    "& > $stamp": {
      "position": "absolute",
      "top": "{space.5}",
      "z-index": "{layer.stamp}"
    }
  },
  "elements": {
    "title": {
      "margin": "0",
      "font-size": "{type.size.xxl}",
      "font-weight": "{type.weight.heavy}",
      "letter-spacing": "{type.letter_spacing.tight}",
      "line-height": "{type.line_height.tight}",
      "text-wrap": "balance"
    },
    "meta": {
      "font-size": "{type.size.sm}",
      "font-weight": "{type.weight.medium}",
      "color": "{color.text.secondary}"
    },
    "more": {
      "display": "inline-flex",
      "align-items": "center",
      "min-height": "{size.touch_target}",
      "font-size": "{type.size.sm}",
      "font-weight": "{type.weight.bold}",
      "color": "{color.accent.default}"
    },
    "stamp": {
      "position": "absolute",
      "padding": "{space.1} {space.3}",
      "border": "{border.width.heavy} solid currentColor",
      "border-radius": "{radius.small}",
      "background": "{color.surface.canvas}",
      "font-weight": "{type.weight.heavy}",
      "font-size": "{type.size.lg}",
      "letter-spacing": "{type.letter_spacing.caps}",
      "text-transform": "uppercase",
      "opacity": "{opacity.hidden}",
      "transition": "opacity {motion.duration.short} {motion.easing.standard}",
      "z-index": "{layer.stamp}",
      "&--yes": {
        "right": "{space.5}",
        "color": "{color.status.success}",
        "transform": "rotate({motion.angle.stamp})"
      },
      "&--no": {
        "left": "{space.5}",
        "color": "{color.status.error}",
        "transform": "rotate(calc({motion.angle.stamp} * -1))"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "transition": "none"
      }
    }
  },
  "states": {
    "top": {
      "z-index": "{layer.stamp}",
      "cursor": "grab"
    },
    "next-1": {
      "z-index": "{layer.raised}",
      "transform": "translateY({space.3}) scale({motion.scale.enter})"
    },
    "next-2": {
      "z-index": "{layer.base}",
      "transform": "translateY({space.6}) scale({motion.scale.back})"
    },
    "dragging": {
      "transition": "none",
      "cursor": "grabbing"
    },
    "gone": {
      "pointer-events": "none"
    },
    "out-right": {
      "transform": "translateX({motion.distance.throw}) rotate({motion.angle.throw})",
      "opacity": "{opacity.hidden}"
    },
    "out-left": {
      "transform": "translateX(calc({motion.distance.throw} * -1)) rotate(calc({motion.angle.throw} * -1))",
      "opacity": "{opacity.hidden}"
    },
    "yes": {
      "& $stamp--yes": {
        "opacity": "{opacity.full}"
      }
    },
    "no": {
      "& $stamp--no": {
        "opacity": "{opacity.full}"
      }
    }
  },
  "interaction": {
    "__more": "link"
  },
  "surface": {
    "base": "poster"
  }
}
