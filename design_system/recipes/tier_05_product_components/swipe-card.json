{
  "className": "swipe-card",
  "uses": [
    "event-art",
    "tag"
  ],
  "purpose": "The weekly pick: artwork fills the card, a fade carries the title, like Disney's featured card.",
  "base": {
    "position": "relative",
    "grid-area": "1 / 1",
    "min-width": "0",
    "display": "flex",
    "flex-direction": "column",
    "justify-content": "flex-end",
    "align-items": "flex-start",
    "gap": "{space.2}",
    "min-height": "{size.deck}",
    "padding": "{size.card.art_clear} {space.5} {space.4}",
    "isolation": "isolate",
    "user-select": "none",
    "transform": "translateX({runtime.swipe_x}) rotate({runtime.swipe_angle})",
    "transition": "transform {motion.duration.medium} {motion.easing.standard}, opacity {motion.duration.medium} {motion.easing.standard}",
    "& .event-art": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "width": "100%",
      "aspect-ratio": "{ratio.square}",
      "border-radius": "0",
      "z-index": "{layer.base}",
      "pointer-events": "none"
    },
    "&::after": {
      "content": "\"\"",
      "position": "absolute",
      "top": "0",
      "left": "0",
      "width": "100%",
      "aspect-ratio": "{ratio.square}",
      "background": "linear-gradient(to top, {color.surface.sunken}, {color.scrim.soft} 50%, {color.scrim.none})",
      "pointer-events": "none"
    },
    "& > *:not(.event-art)": {
      "position": "relative",
      "z-index": "{layer.raised}"
    },
    "& > p": {
      "margin": "0"
    },
    "@media (prefers-reduced-motion: reduce)": {
      "transition": "none"
    },
    "& > $stamp": {
      "position": "absolute",
      "top": "{space.5}",
      "z-index": "{layer.stamp}"
    }
  },
  "elements": {
    "title": {
      "margin": "0",
      "text-wrap": "balance"
    },
    "meta": {
      "color": "{color.text.secondary}"
    },
    "more": {
      "display": "inline-flex",
      "align-items": "center",
      "min-height": "{size.touch_target}",
      "color": "{color.accent.default}"
    },
    "stamp": {
      "position": "absolute",
      "padding": "{space.2} {space.4}",
      "border": "0",
      "border-radius": "{radius.pill}",
      "background": "{color.surface.canvas}",
      "opacity": "{opacity.hidden}",
      "transition": "opacity {motion.duration.short} {motion.easing.standard}",
      "z-index": "{layer.stamp}",
      "&--yes": {
        "right": "{space.5}",
        "color": "{color.status.success}",
        "transform": "rotate({motion.angle.stamp})"
      },
      "&--no": {
        "left": "{space.5}",
        "color": "{color.status.error}",
        "transform": "rotate(calc({motion.angle.stamp} * -1))"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "transition": "none"
      }
    }
  },
  "states": {
    "top": {
      "z-index": "{layer.stamp}",
      "cursor": "grab"
    },
    "next-1": {
      "z-index": "{layer.raised}",
      "transform": "translateY({space.3}) scale({motion.scale.enter})"
    },
    "next-2": {
      "z-index": "{layer.base}",
      "transform": "translateY({space.6}) scale({motion.scale.back})"
    },
    "dragging": {
      "transition": "none",
      "cursor": "grabbing"
    },
    "gone": {
      "pointer-events": "none"
    },
    "out-right": {
      "transform": "translateX({motion.distance.throw}) rotate({motion.angle.throw})",
      "opacity": "{opacity.hidden}"
    },
    "out-left": {
      "transform": "translateX(calc({motion.distance.throw} * -1)) rotate(calc({motion.angle.throw} * -1))",
      "opacity": "{opacity.hidden}"
    },
    "yes": {
      "& $stamp--yes": {
        "opacity": "{opacity.full}"
      }
    },
    "no": {
      "& $stamp--no": {
        "opacity": "{opacity.full}"
      }
    }
  },
  "interaction": {
    "__more": "link"
  },
  "surface": {
    "base": "photo"
  },
  "text": {
    "__title": "title",
    "__meta": "label",
    "__more": "label-strong",
    "__stamp": "stamp"
  },
  "example": "<article class=\"swipe-card\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Thursday Trivia at Alamo Drafthouse</h2><p class=\"swipe-card__meta\">Thu, Nov 26 · 7pm · 5th Street Station</p><p class=\"pick__why\">You liked the last two, and it is a short walk from you.</p><p class=\"pick__social\"><span class=\"faces\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u011.jpg\" alt=\"\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u012.jpg\" alt=\"\"></span>Jada M. and Aaron B. are going</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article>",
  "examples": {
    ".is-yes": "<article class=\"swipe-card is-dragging is-yes\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Thursday Trivia at Alamo Drafthouse</h2><p class=\"swipe-card__meta\">Thu, Nov 26 · 7pm · 5th Street Station</p><p class=\"pick__why\">You liked the last two, and it is a short walk from you.</p><p class=\"pick__social\"><span class=\"faces\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u011.jpg\" alt=\"\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u012.jpg\" alt=\"\"></span>Jada M. and Aaron B. are going</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article>",
    ".is-no": "<article class=\"swipe-card is-dragging is-no\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Thursday Trivia at Alamo Drafthouse</h2><p class=\"swipe-card__meta\">Thu, Nov 26 · 7pm · 5th Street Station</p><p class=\"pick__why\">You liked the last two, and it is a short walk from you.</p><p class=\"pick__social\"><span class=\"faces\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u011.jpg\" alt=\"\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u012.jpg\" alt=\"\"></span>Jada M. and Aaron B. are going</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article>"
  },
  "frame": "block"
}
