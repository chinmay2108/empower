{
  "className": "event-card",
  "uses": [
    "event-art",
    "tag"
  ],
  "purpose": "An event in a grid: artwork first, then title and when, like Disney's wide cards.",
  "interaction": {
    "__link": "card"
  },
  "base": {
    "display": "block",
    "margin": "0",
    "min-width": "0"
  },
  "elements": {
    "link": {
      "display": "block",
      "color": "inherit",
      "text-decoration": "none",
      "border-radius": "{radius.small}",
      "@media (hover: hover)": {
        "&:hover .event-card__media, &.is-hover .event-card__media": {
          "border-color": "{color.border.hairline_strong}"
        }
      }
    },
    "media": {
      "position": "relative",
      "& .tag": {
        "position": "absolute",
        "top": "{space.2}",
        "left": "{space.2}"
      }
    },
    "title": {
      "margin": "{space.3} 0 {space.1}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "__media": "tile"
  },
  "text": {
    "__title": "heading",
    "__meta": "meta"
  },
  "example": "<article class=\"event-card\"><a class=\"event-card__link\" href=\"#\"><div class=\"event-card__media\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><span class=\"tag\">Going</span></div><h2 class=\"event-card__title\">Thursday Trivia at Alamo Drafthouse</h2><p class=\"event-card__meta\">Thu, Nov 26 · 7pm</p></a></article>",
  "frame": "block"
}
