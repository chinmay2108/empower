{
  "className": "event-card",
  "uses": [
    "event-art",
    "tag"
  ],
  "purpose": "An event in a grid: artwork first, then title and when, like Disney's wide cards.",
  "base": {
    "display": "block",
    "margin": "0",
    "min-width": "0"
  },
  "elements": {
    "link": {
      "display": "block",
      "color": "inherit",
      "text-decoration": "none",
      "border-radius": "{radius.small}",
      "transition": "transform {motion.duration.instant} {motion.easing.standard}",
      "&:active": {
        "transform": "scale({motion.scale.card_pressed})"
      },
      "@media (hover: hover)": {
        "&:hover .event-art": {
          "transform": "scale({motion.scale.hover})"
        }
      },
      "@media (prefers-reduced-motion: reduce)": {
        "transition": "none",
        "&:active": {
          "transform": "none"
        },
        "&:hover .event-art": {
          "transform": "none"
        }
      }
    },
    "media": {
      "position": "relative",
      "& .event-art": {
        "transition": "transform {motion.duration.long} {motion.easing.standard}"
      },
      "& .tag": {
        "position": "absolute",
        "top": "{space.2}",
        "left": "{space.2}"
      }
    },
    "title": {
      "margin": "{space.3} 0 {space.1}",
      "font-size": "{type.size.lg}",
      "font-weight": "{type.weight.bold}",
      "line-height": "{type.line_height.snug}"
    },
    "meta": {
      "margin": "0",
      "font-size": "{type.size.sm}",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "__media": "tile"
  }
}
