{
  "className": "people-card",
  "uses": [
    "avatar",
    "tag",
    "ember",
    "mini-btn",
    "star"
  ],
  "purpose": "A person as a small poster: their photo fading into the card, their name, why they are here, and one action. For a match the whole card opens their profile and a star marks a favourite.",
  "base": {
    "position": "relative",
    "display": "flex",
    "flex-direction": "column",
    "min-width": "0",
    "isolation": "isolate",
    "& .star": {
      "position": "absolute",
      "top": "{space.1}",
      "right": "{space.1}",
      "z-index": "{layer.raised}"
    }
  },
  "elements": {
    "media": {
      "position": "relative",
      "& .avatar": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "aspect-ratio": "{ratio.square}",
        "border-radius": "0",
        "object-fit": "cover"
      },
      "& .tag": {
        "position": "absolute",
        "top": "{space.2}",
        "left": "{space.2}",
        "z-index": "{layer.raised}",
        "pointer-events": "none"
      },
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "pointer-events": "none"
      }
    },
    "name": {
      "margin": "0",
      "display": "flex",
      "align-items": "center",
      "gap": "{space.2}",
      "min-width": "0",
      "white-space": "nowrap",
      "overflow": "hidden",
      "text-overflow": "ellipsis"
    },
    "body": {
      "flex": "1",
      "display": "flex",
      "flex-direction": "column",
      "gap": "{space.1}",
      "padding": "0 {space.3} {space.3}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}",
      "display": "-webkit-box",
      "-webkit-box-orient": "vertical",
      "-webkit-line-clamp": "2",
      "overflow": "hidden"
    },
    "actions": {
      "position": "relative",
      "z-index": "{layer.raised}",
      "display": "grid",
      "margin-top": "auto",
      "padding-top": "{space.2}"
    },
    "link": {
      "color": "inherit",
      "text-decoration": "none",
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0"
      }
    }
  },
  "surface": {
    "base": "poster",
    "__media &::after": "photo-fade"
  },
  "text": {
    "__media & .avatar": "glyph-xl",
    "__name": "poster",
    "__meta": "meta"
  },
  "example": "<article class=\"people-card\"><div class=\"people-card__media\"><img class=\"avatar avatar--lg avatar--photo\" src=\"../img/people/u004.jpg\" alt=\"\"><span class=\"tag\">New</span></div><div class=\"people-card__body\"><p class=\"people-card__name\"><a class=\"people-card__link\" href=\"#\">Maya K.</a></p><p class=\"people-card__meta\">Three sessions together at Thursday Trivia.</p><div class=\"people-card__actions\"><a class=\"mini-btn mini-btn--action\" href=\"#\"><svg class=\"mini-btn__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z\"/></svg>Message</a></div></div><button type=\"button\" class=\"star\" aria-pressed=\"true\" aria-label=\"Remove Maya K. from favourites\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z\"/></svg></button></article>",
  "frame": "block",
  "interaction": {
    "__link": "dim"
  },
  "examples": {
    "--familiar": "<article class=\"people-card\"><div class=\"people-card__media\"><img class=\"avatar avatar--lg avatar--photo\" src=\"../img/people/u016.jpg\" alt=\"\"></div><div class=\"people-card__body\"><p class=\"people-card__name\">Devon</p><p class=\"people-card__meta\">You have both been to the last two trivia nights.</p><div class=\"people-card__actions\"><button type=\"button\" class=\"mini-btn mini-btn--action\">Add</button></div></div></article>"
  }
}
