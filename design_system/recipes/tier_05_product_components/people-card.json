{
  "className": "people-card",
  "uses": [
    "avatar",
    "tag",
    "ember",
    "mini-btn"
  ],
  "purpose": "A match as a poster: their photo fills the top, a fade carries their name, then one line of shared context and the two ways to reach them.",
  "base": {
    "display": "flex",
    "flex-direction": "column",
    "min-width": "0",
    "isolation": "isolate"
  },
  "elements": {
    "media": {
      "position": "relative",
      "& .avatar": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "aspect-ratio": "{ratio.square}",
        "border-radius": "0",
        "object-fit": "cover"
      },
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "pointer-events": "none"
      },
      "& .tag": {
        "position": "absolute",
        "top": "{space.2}",
        "left": "{space.2}",
        "z-index": "{layer.raised}"
      }
    },
    "name": {
      "position": "absolute",
      "left": "{space.3}",
      "right": "{space.3}",
      "bottom": "{space.2}",
      "z-index": "{layer.raised}",
      "margin": "0",
      "display": "flex",
      "flex-wrap": "wrap",
      "align-items": "center",
      "gap": "{space.2}",
      "text-shadow": "0 0 {space.2} {color.scrim.strong}"
    },
    "body": {
      "flex": "1",
      "display": "flex",
      "flex-direction": "column",
      "gap": "{space.3}",
      "padding": "{space.3}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    },
    "actions": {
      "display": "grid",
      "gap": "{space.2}",
      "margin-top": "auto"
    }
  },
  "surface": {
    "base": "poster",
    "__media &::after": "photo-fade"
  },
  "text": {
    "__media & .avatar": "glyph-xl",
    "__name": "poster",
    "__meta": "meta"
  },
  "example": "<article class=\"people-card\"><div class=\"people-card__media\"><img class=\"avatar avatar--photo\" src=\"../img/people/u015.jpg\" alt=\"\"><span class=\"tag\">New</span><p class=\"people-card__name\">Maya K.<span class=\"ember ember--glow\" aria-label=\"Empower score 41\"><svg class=\"ember__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5c1.2 3.6 5.5 5.6 5.5 10.7a5.5 5.5 0 0 1-11 0c0-2.8 1.6-4.5 2.7-5.6.3 2.2 1.6 3.3 2.7 3.3 0-3.3-1-5.8.1-8.4z\"/></svg><span class=\"ember__value\">41</span></span></p></div><div class=\"people-card__body\"><p class=\"people-card__meta\">Three sessions together at Thursday Trivia.</p><div class=\"people-card__actions\"><a class=\"mini-btn mini-btn--dark\" href=\"#\">Message</a><a class=\"mini-btn\" href=\"#\">Profile</a></div></div></article>",
  "frame": "block"
}
