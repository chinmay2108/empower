{
  "className": "people-card",
  "uses": [
    "avatar",
    "tag",
    "ember",
    "mini-btn"
  ],
  "purpose": "A match as a poster: their photo fills the top, a fade carries their name, then one line of shared context and the two ways to reach them.",
  "base": {
    "display": "flex",
    "flex-direction": "column",
    "min-width": "0",
    "isolation": "isolate"
  },
  "elements": {
    "media": {
      "position": "relative",
      "& .avatar": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "aspect-ratio": "{ratio.square}",
        "border-radius": "0",
        "object-fit": "cover",
        "font-size": "{type.size.xl}"
      },
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(to top, {color.surface.panel}, {color.scrim.soft} 50%, {color.scrim.none})",
        "pointer-events": "none"
      },
      "& .tag": {
        "position": "absolute",
        "top": "{space.2}",
        "left": "{space.2}",
        "z-index": "{layer.raised}"
      }
    },
    "name": {
      "position": "absolute",
      "left": "{space.3}",
      "right": "{space.3}",
      "bottom": "{space.2}",
      "z-index": "{layer.raised}",
      "margin": "0",
      "display": "flex",
      "flex-wrap": "wrap",
      "align-items": "center",
      "gap": "{space.2}",
      "font-size": "{type.size.lg}",
      "font-weight": "{type.weight.heavy}",
      "line-height": "{type.line_height.tight}",
      "letter-spacing": "{type.letter_spacing.tight}",
      "text-shadow": "0 0 {space.2} {color.scrim.strong}"
    },
    "body": {
      "flex": "1",
      "display": "flex",
      "flex-direction": "column",
      "gap": "{space.3}",
      "padding": "{space.3}"
    },
    "meta": {
      "margin": "0",
      "font-size": "{type.size.sm}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.secondary}"
    },
    "actions": {
      "display": "grid",
      "gap": "{space.2}",
      "margin-top": "auto"
    }
  },
  "surface": {
    "base": "poster"
  }
}
