{
  "className": "people-row",
  "uses": [
    "avatar",
    "ember",
    "mini-btn"
  ],
  "purpose": "Someone you keep seeing, as a row: a square photo, their name, one line of why they are here, and the way to add them.",
  "base": {
    "display": "grid",
    "grid-template-columns": "auto 1fr auto",
    "align-items": "center",
    "gap": "{space.3}",
    "padding": "{space.2}",
    "margin-bottom": "{space.2}",
    "& .avatar": {
      "width": "{size.avatar.lg}",
      "height": "auto",
      "aspect-ratio": "{ratio.square}",
      "border-radius": "{radius.small}",
      "object-fit": "cover"
    }
  },
  "elements": {
    "body": {
      "min-width": "0"
    },
    "name": {
      "margin": "0 0 {space.1}",
      "display": "flex",
      "flex-wrap": "wrap",
      "align-items": "center",
      "gap": "{space.2}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "base": "panel"
  },
  "text": {
    "base & .avatar": "glyph-lg",
    "__name": "subheading",
    "__meta": "meta"
  },
  "example": "<div class=\"people-row\"><img class=\"avatar avatar--photo\" src=\"../img/people/u016.jpg\" alt=\"\"><div class=\"people-row__body\"><p class=\"people-row__name\">Devon R.<span class=\"ember ember--warm\" aria-label=\"Empower score 18\"><svg class=\"ember__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5c1.2 3.6 5.5 5.6 5.5 10.7a5.5 5.5 0 0 1-11 0c0-2.8 1.6-4.5 2.7-5.6.3 2.2 1.6 3.3 2.7 3.3 0-3.3-1-5.8.1-8.4z\"/></svg><span class=\"ember__value\">18</span></span></p><p class=\"people-row__meta\">You have both been to the last two trivia nights.</p></div><button type=\"button\" class=\"mini-btn\" aria-pressed=\"false\">Add</button></div>",
  "frame": "block"
}
