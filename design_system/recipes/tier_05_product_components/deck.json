{
  "className": "deck",
  "purpose": "The stack of weekly picks and its two actions.",
  "base": {
    "display": "grid",
    "isolation": "isolate",
    "margin": "{space.4} 0 {space.6}",
    "touch-action": "pan-y"
  },
  "elements": {
    "actions": {
      "display": "grid",
      "grid-template-columns": "1fr 2fr",
      "gap": "{space.3}",
      "margin": "0",
      "position": "sticky",
      "bottom": "calc({size.nav} + {space.2})",
      "z-index": "{layer.sticky}",
      "padding": "{space.3} 0",
      "background": "linear-gradient(to top, {color.surface.canvas} 50%, {color.scrim.none})"
    },
    "btn": {
      "& svg": {
        "width": "{size.icon.sm}",
        "height": "{size.icon.sm}",
        "fill": "none",
        "stroke": "currentColor",
        "stroke-width": "{border.width.strong}",
        "stroke-linecap": "round",
        "stroke-linejoin": "round"
      }
    }
  },
  "example": "<div class=\"deck\"><article class=\"swipe-card is-next-2\"><img class=\"event-art\" src=\"../img/choir.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Community Choir</h2><p class=\"swipe-card__meta\">Tue, Nov 24 · 6:30pm</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article><article class=\"swipe-card is-next-1\"><img class=\"event-art\" src=\"../img/dance.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Swing Cville Wednesday Lessons</h2><p class=\"swipe-card__meta\">Wed, Nov 25 · 7pm</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article><article class=\"swipe-card is-top\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><span class=\"swipe-card__stamp swipe-card__stamp--yes\">I'm in</span><span class=\"swipe-card__stamp swipe-card__stamp--no\">Pass</span><span class=\"tag\">Your pick this week</span><h2 class=\"swipe-card__title\">Thursday Trivia at Alamo Drafthouse</h2><p class=\"swipe-card__meta\">Thu, Nov 26 · 7pm · 5th Street Station</p><a class=\"swipe-card__more\" href=\"#\">More about this group</a></article></div>",
  "frame": "phone",
  "examples": {
    "__actions": "<div class=\"deck__actions\"><button type=\"button\" class=\"btn btn--secondary deck__btn\" aria-label=\"Pass\">Pass</button><button type=\"button\" class=\"btn deck__btn\" aria-label=\"I'm in\">I'm in</button></div>"
  }
}
