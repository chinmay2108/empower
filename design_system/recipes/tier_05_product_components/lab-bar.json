{
  "className": "lab-bar",
  "purpose": "One comparison bar in the Matching Lab.",
  "text": {
    "base": "meta"
  },
  "base": {
    "display": "grid",
    "grid-template-columns": "{size.lab_label} 1fr {size.touch_target}",
    "align-items": "center",
    "gap": "{space.2}",
    "margin-bottom": "{space.2}"
  },
  "elements": {
    "label": {
      "color": "{color.text.secondary}"
    },
    "value": {
      "font-weight": "{type.weight.bold}",
      "text-align": "right",
      "font-variant-numeric": "tabular-nums"
    },
    "track": {
      "height": "{size.meter}",
      "background": "{color.surface.sunken}",
      "border-radius": "{radius.pill}",
      "overflow": "hidden"
    },
    "fill": {
      "display": "block",
      "height": "100%",
      "width": "{runtime.fill}",
      "border-radius": "{radius.pill}",
      "background": "{color.border.strong}",
      "transition": "width {motion.duration.long} {motion.easing.standard}",
      "&--random": {
        "background": "{color.border.strong}"
      },
      "&--interests": {
        "background": "{color.text.secondary}"
      },
      "&--empower": {
        "background": "{color.accent.default}"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "transition": "none"
      }
    }
  },
  "example": "<div class=\"lab-bar\"><span class=\"lab-bar__label\">Empower picks</span><span class=\"lab-bar__track\"><span class=\"lab-bar__fill lab-bar__fill--empower\"></span></span><span class=\"lab-bar__value\">100%</span></div>",
  "frame": "block",
  "examples": {
    "__fill--random": "<div class=\"lab-bar\"><span class=\"lab-bar__label\">Random picks</span><span class=\"lab-bar__track\"><span class=\"lab-bar__fill lab-bar__fill--random\"></span></span><span class=\"lab-bar__value\">38%</span></div>",
    "__fill--interests": "<div class=\"lab-bar\"><span class=\"lab-bar__label\">Interests only</span><span class=\"lab-bar__track\"><span class=\"lab-bar__fill lab-bar__fill--interests\"></span></span><span class=\"lab-bar__value\">61%</span></div>"
  }
}
