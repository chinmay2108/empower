{
  "className": "event-row",
  "uses": [
    "event-art"
  ],
  "purpose": "An event as a row: small artwork, title, when. Like Disney's episode rows.",
  "base": {
    "display": "grid",
    "grid-template-columns": "{size.card.thumb} 1fr",
    "align-items": "center",
    "gap": "{space.4}",
    "padding": "{space.2}",
    "margin-bottom": "{space.3}",
    "color": "inherit",
    "text-decoration": "none"
  },
  "variants": {
    "kind": {
      "plain": {
        "grid-template-columns": "1fr",
        "padding": "{space.4}"
      },
      "today": {}
    }
  },
  "elements": {
    "body": {
      "display": "block",
      "min-width": "0"
    },
    "title": {
      "display": "block",
      "margin": "0 0 {space.1}"
    },
    "meta": {
      "display": "block",
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "interaction": {
    "base": "surface"
  },
  "surface": {
    "base": "panel",
    "--today": "marked"
  },
  "text": {
    "__title": "subheading",
    "__meta": "meta"
  },
  "example": "<a class=\"event-row\" href=\"#\"><img class=\"event-art\" src=\"../img/games.jpg\" alt=\"\" draggable=\"false\"><span class=\"event-row__body\"><span class=\"event-row__title\">Charlottesville Game Club</span><span class=\"event-row__meta\">Thu, Nov 26 · 5pm · The End Games</span></span></a>",
  "frame": "block"
}
