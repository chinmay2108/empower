{
  "className": "confirm-row",
  "uses": [
    "event-art",
    "mini-btn"
  ],
  "purpose": "A session waiting to be confirmed: its artwork, when it was, and the two answers.",
  "base": {
    "display": "grid",
    "grid-template-columns": "{size.card.thumb} 1fr",
    "align-items": "start",
    "gap": "{space.4}",
    "padding": "{space.2}",
    "margin-bottom": "{space.3}"
  },
  "variants": {
    "kind": {
      "plain": {
        "grid-template-columns": "1fr",
        "padding": "{space.4}"
      }
    }
  },
  "elements": {
    "body": {
      "min-width": "0"
    },
    "title": {
      "margin": "0 0 {space.1}"
    },
    "meta": {
      "margin": "0 0 {space.3}",
      "color": "{color.text.secondary}"
    },
    "actions": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "{space.2}"
    }
  },
  "surface": {
    "base": "panel"
  },
  "text": {
    "__title": "subheading",
    "__meta": "meta"
  },
  "example": "<div class=\"confirm-row\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><div class=\"confirm-row__body\"><p class=\"confirm-row__title\">Thursday Trivia at Alamo Drafthouse</p><p class=\"confirm-row__meta\">Thu, Nov 19 · 7pm</p><div class=\"confirm-row__actions\"><button type=\"button\" class=\"mini-btn mini-btn--dark\">Yes, I went</button><button type=\"button\" class=\"mini-btn\">I didn't make it</button></div></div></div>",
  "frame": "block"
}
