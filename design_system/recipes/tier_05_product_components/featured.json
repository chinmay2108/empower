{
  "className": "featured",
  "uses": [
    "event-art",
    "btn"
  ],
  "purpose": "The home invitation to this week's picks: a strip of event artwork fading into a title and one action.",
  "base": {
    "position": "relative",
    "isolation": "isolate"
  },
  "elements": {
    "art": {
      "position": "relative",
      "display": "grid",
      "grid-template-columns": "1fr 1fr 1fr",
      "gap": "{space.hairline}",
      "& .event-art": {
        "aspect-ratio": "{ratio.poster}",
        "border-radius": "0"
      },
      "&::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(to top, {color.surface.sunken}, {color.scrim.none} 50%)",
        "pointer-events": "none"
      }
    },
    "body": {
      "position": "relative",
      "display": "grid",
      "gap": "{space.2}",
      "margin": "calc({space.7} * -1) 0 0",
      "padding": "0 {space.5} {space.5}",
      "z-index": "{layer.raised}",
      "& .btn": {
        "margin": "{space.3} 0 0"
      }
    },
    "title": {
      "margin": "0"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "base": "photo"
  },
  "text": {
    "__title": "title",
    "__meta": "body"
  },
  "example": "<div class=\"featured\"><div class=\"featured__art\"><img class=\"event-art\" src=\"../img/trivia.jpg\" alt=\"\" draggable=\"false\"><img class=\"event-art\" src=\"../img/dance.jpg\" alt=\"\" draggable=\"false\"><img class=\"event-art\" src=\"../img/volunteer.jpg\" alt=\"\" draggable=\"false\"></div><div class=\"featured__body\"><p class=\"featured__title\">Your weekly picks</p><p class=\"featured__meta\">Just one thing. We've lined up a few.</p><a class=\"btn\" href=\"#\">See this week</a></div></div>",
  "frame": "block"
}
