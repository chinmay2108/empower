{
  "className": "brief",
  "purpose": "What to know before you walk in: short headed notes split by hairlines, like a settings list.",
  "text": {
    "__title": "label-strong",
    "__body": "note",
    "__list": "note"
  },
  "base": {
    "margin": "0 0 {space.6}",
    "border-top": "{border.width.default} solid {color.border.default}"
  },
  "elements": {
    "row": {
      "padding": "{space.4} 0",
      "border-bottom": "{border.width.default} solid {color.border.default}"
    },
    "title": {
      "margin": "0 0 {space.2}",
      "color": "{color.text.primary}"
    },
    "body": {
      "margin": "0",
      "color": "{color.text.secondary}"
    },
    "list": {
      "margin": "0",
      "padding-left": "{space.5}",
      "color": "{color.text.secondary}",
      "& li + li": {
        "margin-top": "{space.1}"
      },
      "& li::marker": {
        "color": "{color.accent.default}"
      }
    }
  },
  "example": "<div class=\"brief\"><div class=\"brief__row\"><p class=\"brief__title\">Getting in</p><p class=\"brief__body\">Walk past the box office and go up the stairs. The room is on the left.</p></div><div class=\"brief__row\"><p class=\"brief__title\">What to expect</p><ul class=\"brief__list\"><li>Teams of four, formed at the bar.</li><li>Two rounds, with a break between them.</li></ul></div></div>",
  "frame": "block"
}
