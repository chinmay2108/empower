{
  "className": "quiz-pair",
  "uses": [
    "option"
  ],
  "purpose": "The two sides of one this-or-that question, as two big keys that fill the screen.",
  "text": {
    "base & .option__title": "answer"
  },
  "base": {
    "display": "grid",
    "gap": "{space.4}",
    "margin-bottom": "{space.6}",
    "& .option": {
      "display": "grid",
      "place-items": "center",
      "min-height": "{size.tile}",
      "padding": "{space.6}",
      "margin-bottom": "0",
      "text-align": "center"
    },
    "& .option__title": {
      "text-wrap": "balance"
    }
  },
  "example": "<div class=\"quiz-pair\"><button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">Somewhere I can talk</p></button><button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">Somewhere there is music</p></button></div>",
  "frame": "block"
}
