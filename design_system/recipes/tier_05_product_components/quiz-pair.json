{
  "className": "quiz-pair",
  "uses": [
    "option"
  ],
  "purpose": "The two sides of one this-or-that question, as an even pair of tiles.",
  "text": {
    "base & .option__title": "heading"
  },
  "base": {
    "display": "grid",
    "gap": "{space.3}",
    "margin-bottom": "{space.6}",
    "& .option": {
      "display": "grid",
      "align-content": "center",
      "min-height": "{size.stamp}",
      "padding": "{space.5}",
      "margin-bottom": "0"
    },
    "& .option__title": {
      "text-wrap": "balance"
    }
  },
  "example": "<div class=\"quiz-pair\"><button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">Somewhere I can talk</p></button><button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">Somewhere there is music</p></button></div>",
  "frame": "block"
}
