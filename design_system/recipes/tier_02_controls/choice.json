{
  "className": "choice",
  "purpose": "One of two or three big answers, such as Yes, Sort of, No.",
  "base": {
    "display": "grid",
    "place-items": "center",
    "min-height": "{size.field}",
    "padding": "{space.3} {space.2}",
    "border": "0",
    "color": "{color.text.primary}",
    "font-family": "inherit",
    "text-align": "center",
    "&[aria-pressed=\"true\"]": {
      "background": "{color.surface.marked}"
    }
  },
  "interaction": {
    "base": "on-dark"
  },
  "text": {
    "base": "label-strong"
  },
  "example": "<button type=\"button\" class=\"choice\" aria-pressed=\"false\">Good</button>",
  "frame": "block",
  "surface": {
    "base": "button-quiet"
  }
}
