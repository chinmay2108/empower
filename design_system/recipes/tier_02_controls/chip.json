{
  "className": "chip",
  "purpose": "A choice you can switch on. On, it fills with a brighter indigo and shows a tick, so it never relies on colour alone.",
  "base": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "{space.1}",
    "min-height": "{size.touch_target}",
    "padding": "{space.2} {space.4}",
    "color": "{color.text.primary}",
    "font-family": "inherit",
    "user-select": "none",
    "border": "0",
    "&[aria-pressed=\"true\"]": {
      "background": "{color.surface.marked}"
    },
    "&[aria-pressed=\"true\"]::before": {
      "content": "\"✓\""
    }
  },
  "interaction": {
    "base": "on-dark"
  },
  "text": {
    "base": "label"
  },
  "example": "<button type=\"button\" class=\"chip\" aria-pressed=\"false\">Walk</button>",
  "frame": "inline",
  "surface": {
    "base": "control"
  }
}
