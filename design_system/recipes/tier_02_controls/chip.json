{
  "className": "chip",
  "purpose": "A choice you can switch on, like Disney's filter chips.",
  "base": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "{space.1}",
    "min-height": "{size.touch_target}",
    "padding": "{space.2} {space.4}",
    "border-radius": "{radius.pill}",
    "border": "{border.width.default} solid {color.border.strong}",
    "background": "transparent",
    "color": "{color.text.primary}",
    "font-family": "inherit",
    "user-select": "none",
    "&[aria-pressed=\"true\"]": {
      "background": "{color.action.primary}",
      "border-color": "{color.action.primary}",
      "color": "{color.text.inverse}"
    }
  },
  "interaction": {
    "base": "toggle"
  },
  "text": {
    "base": "label"
  },
  "example": "<button type=\"button\" class=\"chip\" aria-pressed=\"false\">Walk</button>",
  "frame": "inline"
}
