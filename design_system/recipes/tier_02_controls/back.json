{
  "className": "back",
  "purpose": "The way back to the previous screen.",
  "base": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "{space.2}",
    "min-height": "{size.touch_target}",
    "color": "{color.text.secondary}",
    "text-decoration": "none"
  },
  "elements": {
    "icon": {
      "width": "{size.icon.sm}",
      "height": "{size.icon.sm}",
      "fill": "none",
      "stroke": "currentColor",
      "stroke-width": "{border.width.strong}",
      "stroke-linecap": "round",
      "stroke-linejoin": "round"
    }
  },
  "interaction": {
    "base": "text"
  },
  "text": {
    "base": "label"
  },
  "example": "<a class=\"back\" href=\"#\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>This week</a>",
  "frame": "inline"
}
