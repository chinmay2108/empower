{
  "className": "back",
  "purpose": "The way back to the previous screen.",
  "base": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "{space.2}",
    "min-height": "{size.touch_target}",
    "font-size": "{type.size.sm}",
    "font-weight": "{type.weight.medium}",
    "color": "{color.text.secondary}",
    "text-decoration": "none"
  },
  "elements": {
    "icon": {
      "width": "{size.icon.sm}",
      "height": "{size.icon.sm}",
      "fill": "none",
      "stroke": "currentColor",
      "stroke-width": "{border.width.strong}",
      "stroke-linecap": "round",
      "stroke-linejoin": "round"
    }
  },
  "variants": {
    "kind": {
      "person": {
        "gap": "{space.2}"
      }
    }
  },
  "interaction": {
    "base": "text"
  }
}
