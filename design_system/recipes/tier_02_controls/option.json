{
  "className": "option",
  "purpose": "A selectable row with a title and a line of detail.",
  "base": {
    "display": "block",
    "width": "100%",
    "text-align": "left",
    "text-decoration": "none",
    "color": "inherit",
    "font-family": "inherit",
    "border": "0",
    "padding": "{space.4}",
    "margin-bottom": "{space.3}",
    "&[aria-pressed=\"true\"]": {
      "background": "{color.surface.marked}"
    }
  },
  "elements": {
    "title": {
      "margin": "0 0 {space.hairline}"
    }
  },
  "interaction": {
    "base": "surface"
  },
  "surface": {
    "base": "key-tile"
  },
  "text": {
    "__title": "subheading"
  },
  "example": "<button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">A quiet table of six</p></button>",
  "frame": "block"
}
