{
  "className": "option",
  "purpose": "A selectable row with a title and a line of detail.",
  "base": {
    "display": "block",
    "width": "100%",
    "text-align": "left",
    "text-decoration": "none",
    "color": "inherit",
    "font-family": "inherit",
    "border": "{border.width.strong} solid transparent",
    "padding": "{space.4}",
    "margin-bottom": "{space.2}",
    "&[aria-pressed=\"true\"]": {
      "border-color": "{color.accent.default}"
    }
  },
  "elements": {
    "title": {
      "margin": "0 0 {space.hairline}"
    }
  },
  "interaction": {
    "base": "surface"
  },
  "surface": {
    "base": "panel"
  },
  "text": {
    "__title": "subheading"
  },
  "example": "<button type=\"button\" class=\"option\" aria-pressed=\"false\"><p class=\"option__title\">A quiet table of six</p></button>",
  "frame": "block"
}
