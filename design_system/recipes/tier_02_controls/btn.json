{
  "className": "btn",
  "purpose": "The main action on a screen: candle gold with a soft warm glow. Use one per screen.",
  "surface": {
    "base": "button",
    "--secondary": "button-quiet"
  },
  "base": {
    "display": "inline-flex",
    "align-items": "center",
    "justify-content": "center",
    "gap": "{space.2}",
    "width": "100%",
    "min-height": "{size.touch_target}",
    "padding": "{space.3} {space.6}",
    "border": "0",
    "color": "{color.text.inverse}",
    "font-family": "inherit",
    "text-decoration": "none",
    "text-align": "center",
    "user-select": "none"
  },
  "variants": {
    "tone": {
      "secondary": {
        "color": "{color.text.primary}"
      }
    },
    "size": {
      "small": {
        "min-height": "{size.touch_target}",
        "padding": "{space.2} {space.4}"
      }
    },
    "width": {
      "inline": {
        "width": "auto"
      }
    }
  },
  "defaultVariants": {
    "tone": "default"
  },
  "interaction": {
    "base": "on-light",
    "--secondary": "on-dark"
  },
  "text": {
    "base": "button",
    "--small": "button-small"
  },
  "example": "<button type=\"button\" class=\"btn\">I'm in</button>",
  "frame": "inline"
}
