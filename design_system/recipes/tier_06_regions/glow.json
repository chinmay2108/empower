{
  "name": "glow",
  "className": "has-nav",
  "purpose": "The soft colour glow behind the top of a screen, taken from Disney's home screen. This is the app's one signature move.",
  "base": {
    "background-image": "radial-gradient(ellipse {size.page_width} {size.deck} at 50% 0, {color.glow.ambient}, {color.scrim.none})",
    "background-repeat": "no-repeat",
    "background-attachment": "scroll",
    "& .footer-action": {
      "bottom": "calc({size.nav} + env(safe-area-inset-bottom, 0px))"
    }
  },
  "uses": [
    "footer-action"
  ],
  "example": "<div class=\"has-nav page\"><header class=\"topbar\"><a class=\"back\" href=\"#\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>This week</a><span class=\"topbar__meta\">Week 3</span></header><p class=\"eyebrow\">Thu, Nov 26</p><h1 class=\"title\">Thursday Trivia.</h1><p class=\"subtitle\">Alamo Drafthouse, 5th Street Station.</p><div class=\"card\"><p class=\"card__title\">You're going</p><p class=\"card__meta\">With Jada M. and Aaron B.</p></div></div>",
  "frame": "phone"
}
