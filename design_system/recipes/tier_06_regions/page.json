{
  "className": "page",
  "purpose": "The screen frame: Disney's 20pt side margins, with room for the navigation bar.",
  "uses": [
    "footer-action"
  ],
  "base": {
    "position": "relative",
    "max-width": "{size.page_width}",
    "margin": "0 auto",
    "padding": "calc({space.4} + env(safe-area-inset-top, 0px)) {space.5} calc({size.nav} + {space.7} + env(safe-area-inset-bottom, 0px))",
    "min-height": "100dvh",
    "&:has(.footer-action)": {
      "padding-bottom": "calc({size.nav} + {size.footer_clearance} + env(safe-area-inset-bottom, 0px))"
    }
  },
  "variants": {
    "kind": {
      "wide": {
        "max-width": "{size.page_wide}"
      }
    }
  },
  "example": "<div class=\"page\"><header class=\"topbar\"><a class=\"back\" href=\"#\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>This week</a><span class=\"topbar__meta\">Week 3</span></header><p class=\"eyebrow\">Thu, Nov 26</p><h1 class=\"title\">Thursday Trivia.</h1><p class=\"subtitle\">Alamo Drafthouse, 5th Street Station.</p><div class=\"card\"><p class=\"card__title\">You're going</p><p class=\"card__meta\">With Jada M. and Aaron B.</p></div></div>",
  "frame": "phone"
}
