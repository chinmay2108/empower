{
  "className": "topbar",
  "purpose": "The strip at the top with the wordmark or the way back.",
  "text": {
    "__meta": "label"
  },
  "base": {
    "display": "flex",
    "align-items": "center",
    "justify-content": "space-between",
    "min-height": "{size.touch_target}",
    "margin-bottom": "{space.4}"
  },
  "elements": {
    "meta": {
      "color": "{color.text.secondary}"
    }
  },
  "example": "<header class=\"topbar\"><a class=\"back\" href=\"#\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>This week</a><span class=\"topbar__meta\">Week 3</span></header>",
  "frame": "phone"
}
