{
  "className": "gallery",
  "uses": [
    "page",
    "chat-header",
    "composer",
    "footer-action",
    "nav",
    "toast",
    "ladder-pop"
  ],
  "purpose": "The design-system gallery: the frame that holds one specimen of every recipe, including the ones that normally pin themselves to the window.",
  "base": {
    "display": "block",
    "max-width": "{size.page_wide}",
    "margin": "0 auto",
    "padding": "calc({space.7} + env(safe-area-inset-top, 0px)) {space.5} {space.9}"
  },
  "elements": {
    "lead": {
      "margin": "0 0 {space.7}",
      "font-size": "{type.size.md}",
      "line-height": "{type.line_height.body}",
      "color": "{color.text.secondary}",
      "max-width": "{size.page_width}",
      "text-wrap": "pretty"
    },
    "part": {
      "margin": "{space.9} 0 0",
      "padding": "{space.7} 0 0",
      "border-top": "{border.width.strong} solid {color.border.strong}"
    },
    "part-title": {
      "margin": "0 0 {space.2}",
      "font-size": "{type.size.xl}",
      "font-weight": "{type.weight.heavy}",
      "line-height": "{type.line_height.tight}",
      "letter-spacing": "{type.letter_spacing.tight}"
    },
    "part-note": {
      "margin": "0 0 {space.6}",
      "font-size": "{type.size.sm}",
      "line-height": "{type.line_height.body}",
      "color": "{color.text.secondary}",
      "max-width": "{size.page_width}"
    },
    "group": {
      "margin": "{space.7} 0 0",
      "min-width": "0"
    },
    "label": {
      "display": "block",
      "margin": "0 0 {space.1}",
      "font-size": "{type.size.sm}",
      "font-weight": "{type.weight.heavy}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.accent.default}",
      "overflow-wrap": "anywhere"
    },
    "note": {
      "margin": "0 0 {space.3}",
      "font-size": "{type.size.sm}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.secondary}",
      "max-width": "{size.page_width}"
    },
    "caption": {
      "margin": "0",
      "font-size": "{type.size.xs}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.tertiary}",
      "overflow-wrap": "anywhere"
    },
    "row": {
      "display": "flex",
      "flex-wrap": "wrap",
      "align-items": "flex-start",
      "gap": "{space.4}"
    },
    "cell": {
      "display": "grid",
      "gap": "{space.2}",
      "align-content": "start",
      "min-width": "0",
      "flex": "1",
      "&--wide": {
        "flex-basis": "100%"
      }
    },
    "grid": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fill, minmax(min(100%, {size.card.min}), 1fr))",
      "gap": "{space.4}"
    },
    "swatches": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fill, minmax(min(100%, {size.lab_label}), 1fr))",
      "gap": "{space.3}"
    },
    "scale": {
      "margin": "0 0 {space.4}",
      "padding": "0",
      "list-style": "none"
    },
    "stage": {
      "position": "relative",
      "isolation": "isolate",
      "overflow": "hidden",
      "transform": "translateZ(0)",
      "padding": "{space.5}",
      "border-radius": "{radius.medium}",
      "border": "{border.width.default} solid {color.border.default}",
      "background-color": "{color.surface.canvas}",
      "min-width": "0",
      "& .toast": {
        "position": "static",
        "transform": "none",
        "animation": "none",
        "width": "max-content",
        "margin": "0 auto"
      },
      "& .ladder-pop": {
        "position": "static"
      },
      "& .ladder-pop.is-leaving .ladder-pop__card": {
        "animation": "none"
      },
      "& .nav": {
        "position": "static",
        "height": "{size.nav}",
        "padding-bottom": "0"
      },
      "& .composer": {
        "position": "static"
      },
      "& .footer-action": {
        "position": "static"
      },
      "& .chat-header": {
        "position": "static",
        "margin": "0"
      },
      "&--flush": {
        "padding": "0"
      },
      "&--tall": {
        "min-height": "{size.deck}"
      }
    },
    "fill-full": {
      "--runtime-fill": "100%"
    },
    "fill-half": {
      "--runtime-fill": "50%"
    },
    "fill-quarter": {
      "--runtime-fill": "calc(50% / 2)"
    },
    "screen": {
      "position": "relative",
      "isolation": "isolate",
      "overflow": "hidden",
      "transform": "translateZ(0)",
      "width": "100%",
      "max-width": "{size.page_width}",
      "height": "{size.deck}",
      "border-radius": "{radius.medium}",
      "border": "{border.width.default} solid {color.border.default}",
      "background-color": "{color.surface.canvas}",
      "& .page": {
        "min-height": "100%"
      }
    }
  }
}
