{
  "className": "swatch",
  "purpose": "One colour token as a block of that colour with the token's name under it.",
  "base": {
    "display": "grid",
    "gap": "{space.1}",
    "min-width": "0"
  },
  "elements": {
    "chip": {
      "height": "{size.action}",
      "border-radius": "{radius.small}",
      "background": "{color.surface.canvas}",
      "box-shadow": "inset 0 0 0 {border.width.default} {color.border.default}",
      "&--color-surface-canvas": {
        "background": "{color.surface.canvas}"
      },
      "&--color-surface-sunken": {
        "background": "{color.surface.sunken}"
      },
      "&--color-surface-inverse": {
        "background": "{color.surface.inverse}"
      },
      "&--color-surface-overlay": {
        "background": "{color.surface.overlay}"
      },
      "&--color-text-primary": {
        "background": "{color.text.primary}"
      },
      "&--color-text-secondary": {
        "background": "{color.text.secondary}"
      },
      "&--color-text-tertiary": {
        "background": "{color.text.tertiary}"
      },
      "&--color-text-inverse": {
        "background": "{color.text.inverse}"
      },
      "&--color-action-primary": {
        "background": "{color.action.primary}"
      },
      "&--color-action-primary-pressed": {
        "background": "{color.action.primary_pressed}"
      },
      "&--color-action-secondary": {
        "background": "{color.action.secondary}"
      },
      "&--color-action-secondary-pressed": {
        "background": "{color.action.secondary_pressed}"
      },
      "&--color-accent-default": {
        "background": "{color.accent.default}"
      },
      "&--color-accent-strong": {
        "background": "{color.accent.strong}"
      },
      "&--color-accent-soft": {
        "background": "{color.accent.soft}"
      },
      "&--color-border-default": {
        "background": "{color.border.default}"
      },
      "&--color-border-strong": {
        "background": "{color.border.strong}"
      },
      "&--color-focus-ring": {
        "background": "{color.focus.ring}"
      },
      "&--color-status-success": {
        "background": "{color.status.success}"
      },
      "&--color-status-success-soft": {
        "background": "{color.status.success_soft}"
      },
      "&--color-status-warning": {
        "background": "{color.status.warning}"
      },
      "&--color-status-error": {
        "background": "{color.status.error}"
      },
      "&--color-status-error-soft": {
        "background": "{color.status.error_soft}"
      },
      "&--color-ember-spark": {
        "background": "{color.ember.spark}"
      },
      "&--color-ember-warm": {
        "background": "{color.ember.warm}"
      },
      "&--color-ember-glow": {
        "background": "{color.ember.glow}"
      },
      "&--color-ember-blaze": {
        "background": "{color.ember.blaze}"
      },
      "&--color-scrim-strong": {
        "background": "{color.scrim.strong}"
      },
      "&--color-scrim-soft": {
        "background": "{color.scrim.soft}"
      },
      "&--color-scrim-none": {
        "background": "{color.scrim.none}"
      },
      "&--color-glow-ambient": {
        "background": "{color.glow.ambient}"
      }
    },
    "name": {
      "font-size": "{type.size.xs}",
      "line-height": "{type.line_height.snug}",
      "color": "{color.text.secondary}",
      "overflow-wrap": "anywhere"
    }
  }
}
