{
  "className": "board",
  "purpose": "The review board's own frame: quiet, uniform cards so that only the component inside each one varies.",
  "text": {
    "__lead": "body",
    "__proof": "note",
    "__part-title": "headline",
    "__part-note": "note",
    "__name": "subheading",
    "__purpose": "meta",
    "__meta": "caption",
    "__label": "button-small",
    "__delta": "caption",
    "__token-name": "caption",
    "__token-value": "caption",
    "__surface": "caption"
  },
  "surface": {
    "__box": "fill",
    "__frame": "fill"
  },
  "base": {
    "display": "block",
    "max-width": "{size.page_wide}",
    "margin": "0 auto",
    "overflow-x": "clip",
    "padding": "calc({space.7} + env(safe-area-inset-top, 0px)) {space.5} {space.9}"
  },
  "elements": {
    "lead": {
      "margin": "0 0 {space.4}",
      "max-width": "{size.page_width}",
      "color": "{color.text.secondary}"
    },
    "proof": {
      "margin": "0 0 {space.2}",
      "max-width": "{size.page_width}",
      "padding": "0 0 0 {space.3}",
      "border-left": "{border.width.strong} solid {color.accent.default}",
      "color": "{color.text.secondary}"
    },
    "part": {
      "margin": "{space.9} 0 0",
      "padding": "{space.7} 0 0",
      "border-top": "{border.width.strong} solid {color.border.strong}"
    },
    "part-title": {
      "margin": "0 0 {space.2}",
      "font-weight": "{type.weight.heavy}"
    },
    "part-note": {
      "margin": "0 0 {space.4}",
      "max-width": "{size.page_width}",
      "color": "{color.text.secondary}"
    },
    "family": {
      "margin": "{space.8} 0 0",
      "min-width": "0"
    },
    "name": {
      "margin": "0 0 {space.1}",
      "font-weight": "{type.weight.heavy}",
      "color": "{color.accent.default}"
    },
    "purpose": {
      "margin": "0 0 {space.1}",
      "max-width": "{size.page_width}",
      "color": "{color.text.primary}"
    },
    "meta": {
      "margin": "0 0 {space.4}",
      "color": "{color.text.tertiary}",
      "overflow-wrap": "anywhere"
    },
    "grid": {
      "display": "grid",
      "grid-template-columns": "repeat(auto-fill, minmax(min({size.card.min}, 100%), 1fr))",
      "align-items": "start",
      "gap": "{space.4}"
    },
    "card": {
      "display": "grid",
      "gap": "{space.2}",
      "min-width": "0",
      "margin": "0"
    },
    "label": {
      "margin": "0",
      "color": "{color.text.tertiary}"
    },
    "bed": {
      "position": "relative",
      "min-width": "0",
      "padding": "{space.4}",
      "border": "{border.width.default} solid {color.border.default}",
      "border-radius": "{radius.small}",
      "background": "{color.surface.canvas}",
      "overflow": "clip",
      "overflow-clip-margin": "{space.8}",
      "&--phone": {
        "padding": "0",
        "width": "100%",
        "max-width": "{size.page_width}",
        "height": "{size.deck}",
        "overflow": "hidden",
        "isolation": "isolate",
        "transform": "translateZ(0)"
      },
      "&--page": {
        "padding": "0 {space.4}"
      },
      "&--inline": {
        "display": "flex",
        "align-items": "center",
        "justify-content": "flex-start",
        "min-height": "{size.row}"
      }
    },
    "delta": {
      "margin": "0",
      "color": "{color.text.secondary}",
      "overflow-wrap": "anywhere"
    },
    "token": {
      "display": "grid",
      "grid-template-columns": "1fr 1fr 1fr",
      "align-items": "center",
      "gap": "{space.4}",
      "padding": "{space.2} 0",
      "border-bottom": "{border.width.default} solid {color.border.default}",
      "min-width": "0"
    },
    "token-name": {
      "font-weight": "{type.weight.medium}",
      "color": "{color.text.primary}",
      "overflow-wrap": "anywhere"
    },
    "token-value": {
      "color": "{color.text.tertiary}",
      "overflow-wrap": "anywhere"
    },
    "chip": {
      "height": "{size.touch_target}",
      "border-radius": "{radius.small}",
      "border": "{border.width.default} solid {color.border.default}"
    },
    "bar": {
      "height": "{space.3}",
      "max-width": "100%",
      "border-radius": "{radius.small}",
      "background": "{color.accent.default}"
    },
    "box": {
      "width": "{size.action}",
      "height": "{size.action}"
    },
    "frame": {
      "width": "{size.action}"
    },
    "line": {
      "width": "100%",
      "background": "{color.text.primary}"
    },
    "text": {
      "margin": "0",
      "color": "{color.text.primary}",
      "overflow-wrap": "anywhere"
    },
    "surface": {
      "min-height": "{size.action}",
      "padding": "{space.4}",
      "color": "{color.text.secondary}"
    }
  },
  "waive": {
    "example": "The board is the page that shows every other example, so it cannot sit inside itself."
  }
}
