{
  "className": "big-check",
  "purpose": "The check mark on a done screen.",
  "text": {
    "base": "glyph-xxl"
  },
  "base": {
    "width": "{size.stamp}",
    "height": "{size.stamp}",
    "margin": "{space.8} auto {space.6}",
    "border-radius": "{radius.round}",
    "display": "grid",
    "place-items": "center",
    "background": "{color.status.success_soft}",
    "color": "{color.status.success}",
    "font-weight": "{type.weight.heavy}"
  },
  "example": "<div class=\"big-check\"><svg class=\"check-mark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></div>",
  "frame": "inline"
}
