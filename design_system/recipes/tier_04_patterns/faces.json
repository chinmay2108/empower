{
  "className": "faces",
  "purpose": "A small overlapping stack of the people going.",
  "uses": [
    "avatar"
  ],
  "base": {
    "display": "inline-flex",
    "margin-right": "{space.2}",
    "vertical-align": "middle",
    "& .avatar": {
      "border": "{border.width.strong} solid {color.surface.canvas}"
    },
    "& .avatar + .avatar": {
      "margin-left": "calc({space.2} * -1)"
    }
  },
  "example": "<span class=\"faces\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u006.jpg\" alt=\"\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u007.jpg\" alt=\"\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u008.jpg\" alt=\"\"></span>",
  "frame": "inline"
}
