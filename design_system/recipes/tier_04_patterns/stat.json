{
  "className": "stat",
  "purpose": "One number with its label.",
  "base": {
    "padding": "{space.4}"
  },
  "elements": {
    "value": {
      "font-variant-numeric": "tabular-nums"
    },
    "label": {
      "color": "{color.text.secondary}"
    }
  },
  "surface": {
    "base": "panel"
  },
  "text": {
    "__value": "title",
    "__label": "meta"
  },
  "example": "<div class=\"stat\"><div class=\"stat__value\">7</div><div class=\"stat__label\">hours together</div></div>",
  "frame": "block"
}
