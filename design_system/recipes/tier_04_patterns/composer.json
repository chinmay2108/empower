{
  "className": "composer",
  "purpose": "The message box pinned to the bottom of a chat: a round field, and one gold button that is a microphone until you type. While recording it shows the sound as moving bars.",
  "base": {
    "position": "fixed",
    "left": "0",
    "right": "0",
    "bottom": "0",
    "z-index": "{layer.nav}",
    "padding": "{space.2} {space.3} calc({space.2} + env(safe-area-inset-bottom, 0px))"
  },
  "elements": {
    "inner": {
      "max-width": "{size.page_width}",
      "margin": "0 auto",
      "display": "flex",
      "align-items": "center",
      "gap": "{space.2}"
    },
    "type": {},
    "rec": {
      "justify-content": "space-between"
    },
    "input": {
      "flex": "1",
      "min-width": "0",
      "min-height": "{size.touch_target}",
      "padding": "0 {space.4}",
      "border": "{border.width.default} solid transparent",
      "font": "inherit",
      "color": "{color.text.primary}",
      "&::placeholder": {
        "color": "{color.text.tertiary}"
      }
    },
    "send": {
      "flex": "none",
      "width": "{size.touch_target}",
      "height": "{size.touch_target}",
      "border-radius": "{radius.round}",
      "border": "0",
      "padding": "0",
      "background": "{color.action.primary}",
      "display": "grid",
      "place-items": "center",
      "& svg": {
        "width": "{size.icon.md}",
        "height": "{size.icon.md}",
        "fill": "{color.text.inverse}"
      },
      "&:disabled": {
        "opacity": "{opacity.disabled}",
        "cursor": "default"
      },
      "&--mic": {
        "background": "{color.action.primary}"
      }
    },
    "cancel": {
      "background": "none",
      "border": "0",
      "font": "inherit",
      "color": "{color.text.secondary}",
      "min-height": "{size.touch_target}",
      "padding": "0 {space.3}"
    },
    "timer": {
      "display": "inline-flex",
      "align-items": "center",
      "gap": "{space.2}",
      "font-weight": "{type.weight.medium}",
      "font-variant-numeric": "tabular-nums"
    },
    "wave": {
      "width": "{size.avatar.lg}",
      "height": "{size.icon.md}",
      "fill": "{color.accent.default}",
      "animation": "wave-pulse {motion.duration.pulse} infinite {motion.easing.standard}",
      "@media (prefers-reduced-motion: reduce)": {
        "animation": "none"
      }
    }
  },
  "interaction": {
    "__send": "on-light",
    "__cancel": "text"
  },
  "surface": {
    "base": "bar",
    "__input": "field-round"
  },
  "text": {
    "__input": "body"
  },
  "example": "<form class=\"composer\"><div class=\"composer__inner composer__type\"><input class=\"composer__input\" autocomplete=\"off\" maxlength=\"300\" placeholder=\"Message Felix\" aria-label=\"Message Felix\"><button class=\"composer__send\" type=\"submit\" aria-label=\"Send\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.4 20.4l17.5-7.5a1 1 0 0 0 0-1.8L3.4 3.6a.9.9 0 0 0-1.3 1l1.9 6.4 9 1-9 1-1.9 6.4a.9.9 0 0 0 1.3 1z\"/></svg></button></div></form>",
  "examples": {
    "__cancel": "<form class=\"composer\"><div class=\"composer__inner composer__rec\"><button type=\"button\" class=\"composer__cancel\">Cancel</button><span class=\"composer__timer\"><span class=\"rec-dot\"></span><svg class=\"composer__wave\" viewBox=\"0 0 96 24\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><rect x=\"1\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\"/><rect x=\"5\" y=\"7\" width=\"2\" height=\"10\" rx=\"1\"/><rect x=\"9\" y=\"4\" width=\"2\" height=\"16\" rx=\"1\"/><rect x=\"13\" y=\"8\" width=\"2\" height=\"8\" rx=\"1\"/><rect x=\"17\" y=\"2\" width=\"2\" height=\"20\" rx=\"1\"/><rect x=\"21\" y=\"6\" width=\"2\" height=\"12\" rx=\"1\"/><rect x=\"25\" y=\"1\" width=\"2\" height=\"22\" rx=\"1\"/><rect x=\"29\" y=\"7.5\" width=\"2\" height=\"9\" rx=\"1\"/><rect x=\"33\" y=\"5\" width=\"2\" height=\"14\" rx=\"1\"/><rect x=\"37\" y=\"3\" width=\"2\" height=\"18\" rx=\"1\"/><rect x=\"41\" y=\"8.5\" width=\"2\" height=\"7\" rx=\"1\"/><rect x=\"45\" y=\"6\" width=\"2\" height=\"12\" rx=\"1\"/><rect x=\"49\" y=\"2\" width=\"2\" height=\"20\" rx=\"1\"/><rect x=\"53\" y=\"7\" width=\"2\" height=\"10\" rx=\"1\"/><rect x=\"57\" y=\"4\" width=\"2\" height=\"16\" rx=\"1\"/><rect x=\"61\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\"/><rect x=\"65\" y=\"5.5\" width=\"2\" height=\"13\" rx=\"1\"/><rect x=\"69\" y=\"1\" width=\"2\" height=\"22\" rx=\"1\"/><rect x=\"73\" y=\"7.5\" width=\"2\" height=\"9\" rx=\"1\"/><rect x=\"77\" y=\"3.5\" width=\"2\" height=\"17\" rx=\"1\"/><rect x=\"81\" y=\"6.5\" width=\"2\" height=\"11\" rx=\"1\"/><rect x=\"85\" y=\"2.5\" width=\"2\" height=\"19\" rx=\"1\"/><rect x=\"89\" y=\"8\" width=\"2\" height=\"8\" rx=\"1\"/><rect x=\"93\" y=\"5\" width=\"2\" height=\"14\" rx=\"1\"/></svg><span>0:07</span></span><button type=\"button\" class=\"composer__send\" aria-label=\"Send voice note\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3.4 20.4l17.5-7.5a1 1 0 0 0 0-1.8L3.4 3.6a.9.9 0 0 0-1.3 1l1.9 6.4 9 1-9 1-1.9 6.4a.9.9 0 0 0 1.3 1z\"/></svg></button></div></form>",
    "__send--mic": "<form class=\"composer\"><div class=\"composer__inner composer__type\"><input class=\"composer__input\" autocomplete=\"off\" maxlength=\"300\" placeholder=\"Message Felix\" aria-label=\"Message Felix\"><button class=\"composer__send composer__send--mic\" type=\"submit\" aria-label=\"Record a voice note\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 15a3.5 3.5 0 0 0 3.5-3.5v-6a3.5 3.5 0 0 0-7 0v6A3.5 3.5 0 0 0 12 15zm6-3.5a1 1 0 1 0-2 0 4 4 0 0 1-8 0 1 1 0 1 0-2 0 6 6 0 0 0 5 5.9V20H9a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2h-2v-2.6a6 6 0 0 0 5-5.9z\"/></svg></button></div></form>"
  },
  "frame": "phone",
  "keyframes": {
    "wave-pulse": {
      "50%": {
        "opacity": "{opacity.dim}"
      }
    }
  }
}
