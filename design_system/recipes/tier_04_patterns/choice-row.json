{
  "className": "choice-row",
  "purpose": "A row of two or three big answers.",
  "uses": [
    "choice"
  ],
  "base": {
    "display": "grid",
    "grid-template-columns": "repeat(3, 1fr)",
    "gap": "{space.2}",
    "margin-bottom": "{space.6}"
  },
  "variants": {
    "count": {
      "two": {
        "grid-template-columns": "repeat(2, 1fr)"
      }
    }
  },
  "example": "<div class=\"choice-row\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Great</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Good</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Not for me</button></div>",
  "examples": {
    "--two": "<div class=\"choice-row choice-row--two\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Yes</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">No</button></div>"
  },
  "frame": "block"
}
