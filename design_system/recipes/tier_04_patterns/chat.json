{
  "className": "chat",
  "purpose": "The list of messages, in turns. Messages in one turn sit close; a change of speaker opens a wider gap. Their last message in a turn carries their photo.",
  "text": {
    "__day": "caption",
    "__note": "caption"
  },
  "base": {
    "display": "flex",
    "flex-direction": "column",
    "gap": "{space.3}",
    "margin": "0"
  },
  "elements": {
    "day": {
      "align-self": "center",
      "margin": "{space.4} 0 {space.2}",
      "color": "{color.text.tertiary}",
      "text-align": "center"
    },
    "note": {
      "align-self": "center",
      "max-width": "{size.bubble}",
      "margin": "{space.3} 0 {space.1}",
      "color": "{color.text.tertiary}",
      "text-align": "center"
    },
    "row": {
      "display": "flex",
      "align-items": "flex-end",
      "gap": "{space.2}",
      "&--cont": {
        "padding-left": "calc({size.avatar.sm} + {space.2})"
      }
    },
    "turn": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "{space.1}"
    }
  },
  "example": "<div class=\"chat\"><p class=\"chat__note\">Say hi to Felix. (Replies are simulated in this demo.)</p><p class=\"chat__day\">Mon, Nov 23</p><div class=\"chat__turn\"><div class=\"bubble bubble--me\">Thursday works for me<span class=\"bubble__time\">11:36 AM</span></div></div><div class=\"chat__turn\"><div class=\"chat__row chat__row--cont\"><div class=\"bubble bubble--them\">Me too<span class=\"bubble__time\">11:45 AM</span></div></div><div class=\"chat__row\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u010.jpg\" alt=\"\"><div class=\"bubble bubble--them\">See you there<span class=\"bubble__time\">11:46 AM</span></div></div></div></div>",
  "frame": "block",
  "uses": [
    "avatar"
  ]
}
