{
  "className": "stat-row",
  "purpose": "Two stats side by side.",
  "base": {
    "display": "grid",
    "grid-template-columns": "1fr 1fr",
    "gap": "{space.3}"
  },
  "example": "<div class=\"stat-row\"><div class=\"stat\"><div class=\"stat__value\">7</div><div class=\"stat__label\">hours together</div></div><div class=\"stat\"><div class=\"stat__value\">2</div><div class=\"stat__label\">Kindling connections</div></div></div>",
  "frame": "block"
}
