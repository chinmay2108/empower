{
  "className": "chat-header",
  "uses": [
    "avatar",
    "back"
  ],
  "purpose": "Who you are talking to, pinned at the top of a chat. Round 2: outside the Disney+ reference, so it takes the shared tokens only.",
  "base": {
    "position": "sticky",
    "top": "0",
    "z-index": "{layer.nav}",
    "display": "flex",
    "align-items": "center",
    "justify-content": "flex-start",
    "gap": "{space.2}",
    "margin": "0 calc({space.4} * -1) {space.3}",
    "padding": "calc({space.3} + env(safe-area-inset-top, 0px)) {space.4} {space.3}"
  },
  "elements": {
    "back": {
      "flex": "none",
      "color": "{color.text.primary}",
      "text-decoration": "none",
      "min-width": "{size.touch_target}",
      "min-height": "{size.touch_target}",
      "display": "grid",
      "place-items": "center",
      "margin-left": "calc({space.3} * -1)",
      "& .back__icon": {
        "width": "{size.icon.md}",
        "height": "{size.icon.md}"
      }
    },
    "who": {
      "flex": "1",
      "display": "flex",
      "align-items": "center",
      "gap": "{space.3}",
      "text-decoration": "none",
      "color": "{color.text.primary}",
      "min-width": "0",
      "& > span": {
        "min-width": "0"
      }
    },
    "group": {
      "flex": "none",
      "width": "{size.avatar.md}",
      "height": "{size.avatar.md}",
      "border-radius": "{radius.round}",
      "display": "grid",
      "place-items": "center",
      "background": "{color.accent.soft}",
      "color": "{color.accent.default}"
    },
    "name": {
      "display": "block",
      "white-space": "nowrap",
      "overflow": "hidden",
      "text-overflow": "ellipsis"
    },
    "sub": {
      "display": "block",
      "color": "{color.text.secondary}",
      "white-space": "nowrap",
      "overflow": "hidden",
      "text-overflow": "ellipsis"
    }
  },
  "interaction": {
    "__back": "dim",
    "__who": "dim"
  },
  "surface": {
    "base": "bar"
  },
  "text": {
    "__group": "label-strong",
    "__name": "subheading",
    "__sub": "caption"
  },
  "example": "<header class=\"chat-header\"><a class=\"chat-header__back\" href=\"#\" aria-label=\"Back to People\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg></a><a class=\"chat-header__who\" href=\"#\"><img class=\"avatar avatar--photo\" src=\"../img/people/u010.jpg\" alt=\"\"><span><span class=\"chat-header__name\">Felix C.</span><span class=\"chat-header__sub\">Met at Thursday Trivia at Alamo Drafthouse</span></span></a></header>",
  "frame": "page",
  "examples": {
    "__group": "<header class=\"chat-header\"><a class=\"chat-header__back\" href=\"#\" aria-label=\"Back\"><svg class=\"back__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg></a><span class=\"chat-header__who\"><span class=\"chat-header__group\" aria-hidden=\"true\">TT</span><span><span class=\"chat-header__name\">Thursday Trivia at Alamo Drafthouse</span><span class=\"chat-header__sub\">Thu, Nov 26</span></span></span></header>"
  }
}
