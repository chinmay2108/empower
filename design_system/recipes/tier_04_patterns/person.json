{
  "className": "person",
  "purpose": "A person as a row: photo, name, one line of detail, an action.",
  "uses": [
    "avatar",
    "mini-btn"
  ],
  "text": {
    "__meta": "meta"
  },
  "base": {
    "display": "flex",
    "align-items": "center",
    "gap": "{space.3}",
    "min-height": "{size.row}",
    "padding": "{space.3} 0",
    "border-bottom": "{border.width.default} solid {color.border.default}",
    "text-decoration": "none"
  },
  "elements": {
    "body": {
      "flex": "1",
      "min-width": "0"
    },
    "name": {
      "margin": "0",
      "font-weight": "{type.weight.bold}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "example": "<div class=\"person\"><img class=\"avatar avatar--photo\" src=\"../img/people/u005.jpg\" alt=\"\"><div class=\"person__body\"><p class=\"person__name\">Maya K.</p><p class=\"person__meta\">You've been at 3 sessions together</p></div><button type=\"button\" class=\"mini-btn\" aria-pressed=\"false\">Add</button></div>",
  "frame": "block"
}
