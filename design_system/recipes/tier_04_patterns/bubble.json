{
  "className": "bubble",
  "purpose": "One chat message. Theirs sits on the indigo panel; yours fills with the deeper indigo-blue, so the two sides differ by colour and by side.",
  "text": {
    "base": "message",
    "__time": "caption",
    "--app": "note"
  },
  "base": {
    "max-width": "{size.bubble}",
    "padding": "{space.3} {space.4}",
    "border-radius": "{radius.bubble}",
    "overflow-wrap": "anywhere"
  },
  "elements": {
    "who": {
      "display": "flex",
      "align-items": "center",
      "gap": "{space.2}",
      "margin-bottom": "{space.1}"
    },
    "time": {
      "float": "right",
      "margin": "{space.2} 0 0 {space.3}",
      "color": "{color.text.tertiary}"
    }
  },
  "variants": {
    "side": {
      "them": {
        "align-self": "flex-start",
        "justify-self": "start",
        "border-bottom-left-radius": "{radius.small}"
      },
      "me": {
        "align-self": "flex-end",
        "justify-self": "end",
        "background": "{color.accent.strong}",
        "color": "{color.text.primary}",
        "border-bottom-right-radius": "{radius.small}",
        "& $time": {
          "color": "{color.text.secondary}"
        }
      },
      "app": {
        "align-self": "stretch",
        "justify-self": "stretch",
        "max-width": "none",
        "background": "{color.accent.soft}",
        "border-radius": "{radius.medium}"
      },
      "typing": {
        "display": "flex",
        "gap": "{space.1}",
        "padding": "{space.3} {space.4}",
        "& span": {
          "width": "{size.dot}",
          "height": "{size.dot}",
          "border-radius": "{radius.round}",
          "background": "{color.text.secondary}",
          "animation": "typing-dot {motion.duration.pulse} infinite {motion.easing.standard}"
        },
        "& span:nth-child(2)": {
          "animation-delay": "{motion.duration.short}"
        },
        "& span:nth-child(3)": {
          "animation-delay": "{motion.duration.medium}"
        },
        "@media (prefers-reduced-motion: reduce)": {
          "& span": {
            "animation": "none"
          }
        }
      }
    }
  },
  "keyframes": {
    "typing-dot": {
      "0%, 60%, 100%": {
        "opacity": "{opacity.dim}",
        "transform": "none"
      },
      "30%": {
        "opacity": "{opacity.full}",
        "transform": "translateY(calc({space.1} * -1))"
      }
    }
  },
  "example": "<div class=\"bubble bubble--them\">See you there<span class=\"bubble__time\">11:46 AM</span></div>",
  "examples": {
    "--typing": "<div class=\"bubble bubble--them bubble--typing\" aria-label=\"Felix is typing\"><span></span><span></span><span></span></div>",
    "--me": "<div class=\"bubble bubble--me\">Thursday works for me<span class=\"bubble__time\">11:36 AM</span></div>",
    "__who": "<div class=\"bubble bubble--them\"><span class=\"bubble__who\"><img class=\"avatar avatar--sm avatar--photo\" src=\"../img/people/u009.jpg\" alt=\"\"><strong>Felix</strong></span>See you there<span class=\"bubble__time\">11:46 AM</span></div>"
  },
  "frame": "block",
  "surface": {
    "--them": "panel"
  }
}
