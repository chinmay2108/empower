{
  "className": "card",
  "purpose": "A panel that groups one thing. Image cards live in the product tier.",
  "base": {
    "display": "block",
    "padding": "{space.4}",
    "margin-bottom": "{space.3}",
    "color": "inherit"
  },
  "elements": {
    "title": {
      "margin": "0 0 {space.1}"
    },
    "meta": {
      "margin": "0",
      "color": "{color.text.secondary}"
    }
  },
  "variants": {
    "tone": {
      "outline": {
        "border": "{border.width.default} solid {color.border.default}"
      },
      "accent": {
        "background": "{color.accent.soft}"
      }
    }
  },
  "defaultVariants": {
    "tone": "default"
  },
  "surface": {
    "base": "panel",
    "--accent": "marked"
  },
  "text": {
    "__title": "heading",
    "__meta": "meta"
  },
  "example": "<div class=\"card\"><p class=\"card__title\">Thursday Trivia at Alamo Drafthouse</p><p class=\"card__meta\">Thu, Nov 26 · 7pm · 5th Street Station</p></div>",
  "frame": "block"
}
