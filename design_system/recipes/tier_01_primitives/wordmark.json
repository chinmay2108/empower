{
  "className": "wordmark",
  "purpose": "The Empower name in the top bar.",
  "base": {
    "font-weight": "{type.weight.heavy}",
    "font-size": "{type.size.lg}",
    "letter-spacing": "{type.letter_spacing.tight}",
    "text-decoration": "none",
    "& span": {
      "color": "{color.accent.default}"
    },
    "display": "inline-flex",
    "align-items": "center",
    "min-height": "{size.touch_target}"
  },
  "interaction": {
    "base": "dim"
  }
}
