{
  "className": "wordmark",
  "purpose": "The Empower name in the top bar.",
  "base": {
    "text-decoration": "none",
    "& span": {
      "color": "{color.accent.default}"
    },
    "display": "inline-flex",
    "align-items": "center",
    "min-height": "{size.touch_target}"
  },
  "interaction": {
    "base": "dim"
  },
  "text": {
    "base": "poster"
  },
  "example": "<a class=\"wordmark\" href=\"#\">empower<span>.</span></a>",
  "frame": "inline"
}
