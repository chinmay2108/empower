{
  "name": "text-helpers",
  "global": true,
  "purpose": "Small text and layout helpers used inside any component.",
  "rules": {
    ".muted": {
      "color": "{color.text.secondary}"
    },
    ".small": {
      "font-size": "{type.size.sm}",
      "line-height": "{type.line_height.snug}"
    },
    ".center": {
      "text-align": "center"
    },
    ".flush": {
      "margin": "0"
    },
    ".mt-3": {
      "margin-top": "{space.3}",
      "margin-bottom": "0"
    },
    ".mt-4": {
      "margin-top": "{space.4}",
      "margin-bottom": "0"
    },
    ".is-hidden": {
      "display": "none !important"
    },
    ".list-plain": {
      "list-style": "none",
      "padding": "0",
      "margin": "0"
    }
  }
}
