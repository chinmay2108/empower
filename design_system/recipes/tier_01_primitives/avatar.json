{
  "className": "avatar",
  "purpose": "A person's photo or initials in a circle.",
  "base": {
    "flex": "none",
    "width": "{size.avatar.md}",
    "height": "{size.avatar.md}",
    "border-radius": "{radius.round}",
    "display": "grid",
    "place-items": "center",
    "font-weight": "{type.weight.bold}",
    "color": "{color.text.primary}",
    "object-fit": "cover"
  },
  "variants": {
    "size": {
      "sm": {
        "width": "{size.avatar.xs}",
        "height": "{size.avatar.xs}"
      },
      "lg": {
        "width": "{size.avatar.lg}",
        "height": "{size.avatar.lg}"
      }
    },
    "kind": {
      "photo": {
        "padding": "0"
      }
    }
  },
  "defaultVariants": {
    "size": "default"
  },
  "surface": {
    "base": "fill"
  },
  "text": {
    "base": "glyph-sm",
    "--sm": "glyph-xs",
    "--lg": "glyph-lg"
  },
  "example": "<div class=\"avatar\">MK</div>",
  "examples": {
    "--photo": "<img class=\"avatar avatar--photo\" src=\"../img/people/u009.jpg\" alt=\"\">"
  },
  "frame": "inline"
}
